# ─────────────────────────────────────────────────────────────────────────────
# ByteSend — Docker production environment template
#
# Copy this file to .env in the same directory as docker/prod/compose.yml,
# then edit the values before running:
#
#   docker compose --env-file .env up -d
#
# ─────────────────────────────────────────────────────────────────────────────


# ── PostgreSQL ────────────────────────────────────────────────────────────────

POSTGRES_USER=bytesend
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bytesend

# Must match the credentials above — uses the 'postgres' service hostname
DATABASE_URL=postgresql://bytesend:changeme@postgres:5432/bytesend


# ── Redis ─────────────────────────────────────────────────────────────────────

# Uses the 'redis' service hostname
REDIS_URL=redis://redis:6379


# ── MinIO (built-in S3-compatible storage) ────────────────────────────────────
# Remove the minio service from compose.yml and set S3_COMPATIBLE_* directly
# if you prefer an external bucket (AWS S3, Cloudflare R2, Backblaze B2, etc.)

MINIO_ROOT_USER=bytesend
MINIO_ROOT_PASSWORD=changeme

# These point at the bundled MinIO container — adjust if using external storage
S3_COMPATIBLE_ACCESS_KEY=bytesend
S3_COMPATIBLE_SECRET_KEY=changeme
S3_COMPATIBLE_API_URL=http://minio:9002
S3_COMPATIBLE_PUBLIC_URL=http://your-domain.com:9002/bytesend
S3_COMPATIBLE_BUCKET=bytesend


# ── Application ───────────────────────────────────────────────────────────────

# Public URL of your ByteSend instance (must be HTTPS in production)
NEXTAUTH_URL=https://your-domain.com

# Random secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Port to expose the web app on (default 3000)
PORT=3000


# ── AWS SES (email delivery) ──────────────────────────────────────────────────

AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_DEFAULT_REGION=eu-west-1


# ── Email ─────────────────────────────────────────────────────────────────────

FROM_EMAIL=noreply@your-domain.com

# Optional: external SMTP relay for transactional account emails
# SMTP_HOST=
# SMTP_USER=


# ── OAuth sign-in ─────────────────────────────────────────────────────────────
# At least one is recommended. All are optional individually.

# GitHub — https://github.com/settings/applications/new
GITHUB_ID=
GITHUB_SECRET=

# Discord — https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── Rate limiting ─────────────────────────────────────────────────────────────

API_RATE_LIMIT=1
AUTH_EMAIL_RATE_LIMIT=5


# ── Admin ─────────────────────────────────────────────────────────────────────

ADMIN_EMAIL=


# ── SMTP relay server ─────────────────────────────────────────────────────────

# The internal URL the SMTP container uses to reach the web app
BYTESEND_BASE_URL=http://web:3000

# Username clients authenticate with (password is an API key from the dashboard)
SMTP_AUTH_USERNAME=bytesend

# TLS mode: 'none' (default, use behind a reverse proxy) or 'manual'
SMTP_TLS_MODE=none
# SMTP_TLS_CERT_PATH=/certs/fullchain.pem
# SMTP_TLS_KEY_PATH=/certs/privkey.pem
